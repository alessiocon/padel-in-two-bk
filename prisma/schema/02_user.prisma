enum UserRole {
  USER       @map("user")
  CLUB_OWNER @map("club_owner")
  ADMIN      @map("admin")

  @@map("user_role")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(320)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  username          String    @unique @db.VarChar(50)
  isEmailVerified   Boolean   @default(false) @map("is_email_verified")
  phone             String    @unique @db.VarChar(30) @map("phone")
  
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  // Relazioni
  player            Player?           @relation("UserPlayer")
  memberships       ClubMember[]      @relation("MembershipsClub")
  
  createdBookings   Booking[]         @relation("BookingCreator")
  bookingLogs       BookingLogs[]     @relation("UserBookingLogs")

  @@map("users")
}



enum TokenType {
  EMAIL_VERIFICATION  @map("email_verification")
  PASSWORD_RESET      @map("password_reset")
  CLUB_INVITATION     @map("club_invitation")

  @@map("token_type")
}


model Token {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  type        TokenType
  referenceId String    @map("reference_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([referenceId])
  @@index([type])
  @@map("tokens")
}
