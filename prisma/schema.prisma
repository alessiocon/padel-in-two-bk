generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER       @map("user")
  CLUB_OWNER @map("club_owner")
  ADMIN      @map("admin")

  @@map("user_role")
}

enum ClubStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("club_status")
}

enum CourtStatus {
  AVAILABLE   @map("available")
  RESERVED    @map("reserved")
  MAINTENANCE @map("maintenance")
  INACTIVE    @map("inactive")

  @@map("court_status")
}

enum BookingStatus {
  RESERVED    @map("reserved")
  PENDING     @map("pending")
  CONFIRMED   @map("confirmed")
  CANCELLED   @map("cancelled")

  @@map("booking_status")
}

enum BookingCancBy {
  USER  @map("user")
  CLUB  @map("club")
}

enum TokenType {
  EMAIL_VERIFICATION  @map("email_verification")
  PASSWORD_RESET      @map("password_reset")
  CLUB_INVITATION     @map("club_invitation")

  @@map("token_type")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(320)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  username          String    @unique @db.VarChar(50)
  isEmailVerified   Boolean   @default(false) @map("is_email_verified")
  phone             String?   @unique @db.VarChar(30) @map("phone")
  role              UserRole  @default(USER)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  // Relazioni
  bookings Booking[]
  clubs    Club[]    @relation("ClubOwner")
  teamsAsPlayer1 TournamentTeam[] @relation("Player1")
  teamsAsPlayer2 TournamentTeam[] @relation("Player2")

  @@map("users")
}

model Club {
  id                  String     @id @default(uuid()) @db.Uuid
  ownerId             String     @map("owner_id") @db.Uuid
  name                String     @db.VarChar(160)
  email               String     @unique @db.VarChar(320)
  status              ClubStatus @default(ACTIVE)
  timezone            String     @default("Europe/Rome") @db.VarChar(50)
  position            String     @default("") @db.VarChar(150)
  racketPrice         Decimal    @default(0.00) @map("racket_price") @db.Decimal(10, 2)
  slotDurationMinutes Int        @default(90) @map("slot_duration_minutes")
  openingTime         String     @default("08:00") @map("opening_time") @db.VarChar(5)
  closingTime         String     @default("23:00") @map("closing_time") @db.VarChar(5)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relazioni
  owner    User      @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  courts   Court[]
  bookings Booking[]

  @@index([ownerId])
  @@map("clubs")
}

model Court {
  id            String        @id @default(uuid()) @db.Uuid
  clubId        String        @map("club_id") @db.Uuid
  name          String        @db.VarChar(120)
  price         Decimal       @default(0.00) @map("slot_price") @db.Decimal(10, 2)
  status        CourtStatus   @default(AVAILABLE)
  isIndoor      Boolean       @default(false) @map("is_indoor")
  offsetMinutes Int           @default(0) @map("offset_minutes")

  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  bookings Booking[]
  matches       TournamentMatch[]

  @@unique([clubId, name])
  @@unique([id, clubId])
  @@index([clubId, status])
  @@map("courts")
}

model Booking {
  id                String            @id @default(uuid()) @db.Uuid
  clubId            String            @map("club_id") @db.Uuid
  courtId           String            @map("court_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  description       String?           @db.VarChar(255)

  startsAt          DateTime          @map("starts_at") @db.Timestamptz
  endsAt            DateTime          @map("ends_at") @db.Timestamptz
  status            BookingStatus     @default(RESERVED)

  cancBy            BookingCancBy?    @map("cancelled_by")       
  cancAt            DateTime?         @map("cancelled_at")       
  cancPostConfirm   Boolean?          @map("cancelled_post_confirm")
  cancReason        String?           @db.VarChar(255) @map("cancellation_reason")

  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  club              Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  court             Court             @relation(fields: [courtId, clubId], references: [id, clubId], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([id, clubId])
  @@index([clubId, startsAt, endsAt])
  @@index([courtId, startsAt, endsAt])
  @@index([userId])
  @@map("bookings")
}

model Token {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  type        TokenType
  referenceId String    @map("reference_id") @db.Uuid // ID generico (User, Club, ecc.)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([referenceId])
  @@index([type])
  @@map("tokens")
}


  model Tournament {
    id            String    @id @default(uuid()) @db.Uuid
    title         String    @db.VarChar(150)
    description   String?   @db.Text
    position      String    @db.VarChar(150)
    municipality  String    @db.VarChar(32)
    province      String    @db.VarChar(32)
    award         String    @db.VarChar(150)
    startsAt      DateTime  @map("starts_at") @db.Timestamptz
    endsAt        DateTime  @map("ends_at") @db.Timestamptz
    timezone      String    @default("Europe/Rome") @db.VarChar(50)
    maxTeams      Int       @default(8) @map("max_teams")
    isClosed      Boolean   @default(false) @map("is_closed")
    isVisible     Boolean   @default(false) @map("is_visible")
    showTeams     Boolean   @default(false) @map("show_teams")

    teams       TournamentTeam[]
    matches     TournamentMatch[]

    createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

    @@map("tournaments")
  }


  model TournamentTeam {
    id               String     @id @default(uuid()) @db.Uuid
    tournamentId     String     @map("tournament_id") @db.Uuid
    tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
    
    teamName         String     @map("team_name") @db.VarChar(100)
    
    player1Id        String     @map("player1_id") @db.Uuid
    player1          User       @relation("Player1", fields: [player1Id], references: [id])
    
    player2Id        String?    @map("player2_id") @db.Uuid
    player2          User?      @relation("Player2", fields: [player2Id], references: [id])
    player2FName     String?    @map("player2_fname") @db.VarChar(24)
    player2LName     String?    @map("player2_lname") @db.VarChar(24)
    player2Phone     String?    @map("player2_phone") @db.VarChar(30)  


    matchesAsTeam1  TournamentMatch[] @relation("MatchTeam1")
    matchesAsTeam2  TournamentMatch[] @relation("MatchTeam2")
    wonMatches      TournamentMatch[] @relation("MatchWinner")

    createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
    updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

    @@map("tournament_teams")
  }


  //Match
  enum MatchStatus {
    SCHEDULED   @map("scheduled")
    IN_PROGRESS @map("in_progress")
    COMPLETED   @map("completed")
    CANCELLED   @map("cancelled")

    @@map("match_status")
  }

  enum MatchFormat {
    SINGLE_SET  @map("single_set")
    BEST_OF_3   @map("best_of_3")

    @@map("match_format")
  }

  model TournamentMatch {
    id           String      @id @default(uuid()) @db.Uuid
    tournamentId String      @map("tournament_id") @db.Uuid
    courtId      String?     @map("court_id") @db.Uuid

    team1Id      String?     @map("team1_id") @db.Uuid
    team2Id      String?     @map("team2_id") @db.Uuid
    winnerTeamId String?     @map("winner_team_id") @db.Uuid

    // Struttura matematica PURA dell'albero
    round        Int         @map("round")        // 1 = Finale, 2 = Semifinale, 3 = Quarti, ecc.
    matchOrder   Int         @map("match_order")  // Posizione nel round (0, 1, 2, 3...)
    format          MatchFormat @default(SINGLE_SET) @map("format")

    status       MatchStatus @default(SCHEDULED) @map("status")
    scheduledAt  DateTime?   @map("scheduled_at") @db.Timestamptz

    createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
    updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

    // Relazioni
    tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
    court        Court?              @relation(fields: [courtId], references: [id], onDelete: SetNull)
    team1        TournamentTeam?     @relation("MatchTeam1", fields: [team1Id], references: [id], onDelete: Cascade)
    team2        TournamentTeam?     @relation("MatchTeam2", fields: [team2Id], references: [id], onDelete: Cascade)
    winnerTeam   TournamentTeam?     @relation("MatchWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)

    sets         TournamentMatchSet[]

    @@unique([tournamentId, round, matchOrder]) // Una sola partita per posizione specifica nel torneo
    @@index([tournamentId, round])
    @@map("tournament_matches")
  }

  model TournamentMatchSet {
    id          String          @id @default(uuid()) @db.Uuid
    matchId     String          @map("match_id") @db.Uuid
    setNumber   Int             @map("set_number") // 1, 2, 3
    team1Games  Int             @default(0) @map("team1_games")
    team2Games  Int             @default(0) @map("team2_games")
    tieBreak    Boolean         @default(false) @map("tie_break")

    match       TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

    @@unique([matchId, setNumber])
    @@map("tournament_match_sets")
  }
